# 首次运行 install.sh 时填写域名，或通过 --domain 传入。不要写 https://。
DOMAIN=chat.example.com
CERTBOT_EMAIL=admin@example.com

# true：脚本管理系统 Nginx 和 HTTPS；已有宝塔/代理时设为 false。
MANAGE_NGINX=true
APP_PORT=3000
CHATWOOT_IMAGE=myuwhn/chatwoot:local

# 留空时由脚本根据 DOMAIN 自动生成。
FRONTEND_URL=
FORCE_SSL=true
DEFAULT_LOCALE=zh_CN
ENABLE_EMAIL_CONFIRMATION=false
ENABLE_ACCOUNT_SIGNUP=false

RAILS_ENV=production
NODE_ENV=production
INSTALLATION_ENV=docker
RAILS_LOG_TO_STDOUT=true
RAILS_SERVE_STATIC_FILES=true
ACTIVE_STORAGE_SERVICE=local
RAILS_MAX_THREADS=5
SIDEKIQ_CONCURRENCY=5

# 首次运行自动生成；以后保留原值，不重新生成。
SECRET_KEY_BASE=
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DATABASE=chatwoot
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=

# 关闭邮箱确认不等于启用邮件发送；需要邀请/找回密码/邮件通知时再配置 SMTP。
# MAILER_SENDER_EMAIL=Support <support@example.com>
# SMTP_ADDRESS=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_AUTHENTICATION=login
# SMTP_ENABLE_STARTTLS_AUTO=true
