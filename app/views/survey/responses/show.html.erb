<!DOCTYPE html>
<html>
  <head>
    <title></title>
    <%= csrf_meta_tags %>
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=0" />
    <script>
      window.globalConfig = <%= raw @global_config.merge(
        'INSTALLATION_NAME' => '',
        'BRAND_NAME' => '',
        'BRAND_URL' => '',
        'TERMS_URL' => '',
        'PRIVACY_URL' => '',
        'WIDGET_BRAND_URL' => '',
        'LOGO_THUMBNAIL' => ''
      ).to_json %>
    </script>
    <%= vite_client_tag %>
    <%= vite_javascript_tag 'survey' %>
  </head>
  <body>
    <div id="app"></div>
    <%= yield %>
  </body>
</html>
